#!/bin/bash
# Token Counter — zaehlt Tokens in Dateien oder Stdin
# Usage: token-count [datei1] [datei2] ...
#        echo "text" | token-count
#        token-count                    → zaehlt CLAUDE.md

BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
GRAY='\033[0;90m'
NC='\033[0m'

count_tokens() {
    local file="$1"
    local name="$2"

    local chars=$(wc -c < "$file" | tr -d ' ')
    local words=$(wc -w < "$file" | tr -d ' ')
    local lines=$(wc -l < "$file" | tr -d ' ')
    local tokens=$(ttok < "$file" 2>/dev/null)
    local claude_low=$(( tokens * 115 / 100 ))
    local claude_high=$(( tokens * 125 / 100 ))
    local pct_low=$(python3 -c "print(f'{${tokens}/200000*100:.1f}')")
    local pct_high=$(python3 -c "print(f'{${claude_high}/200000*100:.1f}')")

    echo ""
    echo -e "${BLUE}━━━ ${name} ━━━${NC}"
    echo -e "${GRAY}${chars} chars | ${words} words | ${lines} lines${NC}"
    echo -e "tiktoken:        ${GREEN}${tokens}${NC} tokens"
    echo -e "Claude (~1.2x):  ${YELLOW}${claude_low} - ${claude_high}${NC} tokens"
    echo -e "Kontext (200K):  ${pct_low}% - ${pct_high}%"
}

# Keine Argumente → CLAUDE.md zaehlen
if [ $# -eq 0 ]; then
    echo -e "${BLUE}=== Token Counter ===${NC}"

    # Global CLAUDE.md
    [ -f ~/.claude/CLAUDE.md ] && count_tokens ~/.claude/CLAUDE.md "~/.claude/CLAUDE.md (global)"

    # Projekt CLAUDE.md
    [ -f ./CLAUDE.md ] && count_tokens ./CLAUDE.md "./CLAUDE.md (projekt)"

    # .claude/rules/
    if [ -d .claude/rules ]; then
        for f in .claude/rules/*.md; do
            [ -f "$f" ] && count_tokens "$f" "$f"
        done
    fi

    # AGENTS.md
    [ -f ./AGENTS.md ] && count_tokens ./AGENTS.md "./AGENTS.md"

    # Gesamt
    echo ""
    total=0
    [ -f ~/.claude/CLAUDE.md ] && total=$((total + $(ttok < ~/.claude/CLAUDE.md)))
    [ -f ./CLAUDE.md ] && total=$((total + $(ttok < ./CLAUDE.md)))
    if [ -d .claude/rules ]; then
        for f in .claude/rules/*.md; do
            [ -f "$f" ] && total=$((total + $(ttok < "$f")))
        done
    fi
    [ -f ./AGENTS.md ] && total=$((total + $(ttok < ./AGENTS.md)))

    claude_total=$(( total * 120 / 100 ))
    echo -e "${BLUE}━━━ GESAMT ━━━${NC}"
    echo -e "Alle Config-Dateien: ${GREEN}~${total}${NC} tokens (Claude: ~${claude_total})"
    echo -e "Verbleibend:         ~$((200000 - claude_total)) von 200K"
    exit 0
fi

# Dateien als Argumente
echo -e "${BLUE}=== Token Counter ===${NC}"
for file in "$@"; do
    if [ -f "$file" ]; then
        count_tokens "$file" "$file"
    else
        echo -e "\n${YELLOW}Datei nicht gefunden: ${file}${NC}"
    fi
done
